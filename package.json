{
  "name": "gamification-take-home",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "test": "vitest run",
    "test:deep": "FC_RANDOM=1 FC_RUNS=150 FC_TIMEOUT_MS=280000 vitest run test/properties.test.ts --testTimeout=290000",
    "verify": "npm run typecheck && npm run lint && npm test",
    "web:install": "npm ci --prefix web",
    "web:build": "npm run build --prefix web",
    "web:typecheck": "npm run typecheck --prefix web",
    "verify:web": "npm run web:install && npm run web:typecheck && npm test --prefix web && npm run web:build",
    "build": "tsc -p tsconfig.build.json && cp src/schema.sql dist/ && cp -r src/fake-casino/public dist/fake-casino/",
    "start": "node dist/main.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tigerbeetle-node": "0.17.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/testing": "^12.6.0",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.8"
  }
}
